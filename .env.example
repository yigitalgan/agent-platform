# LLM sağlayıcısı: "anthropic" (doğrudan Anthropic API) veya "openrouter"
# (OpenRouter'ın Anthropic-uyumlu endpoint'i). Varsayılan: anthropic
LLM_PROVIDER=anthropic

# LLM_PROVIDER=anthropic iken gerekli
ANTHROPIC_API_KEY=

# LLM_PROVIDER=openrouter iken gerekli (aksi halde opsiyonel/boş bırakılabilir)
OPENROUTER_API_KEY=

# Tavily web araması (web_search tool'u) için. OPSİYONEL — boşsa backend yine
# başlar, yalnız web_search tool'u "hata: TAVILY_API_KEY ayarlanmamış" döner.
# Ücretsiz tier ~1000 arama/ay. Anahtar: https://tavily.com
TAVILY_API_KEY=

# Paylaşılan API anahtarı — TÜM /api/v1/* istekleri X-API-Key header'ında bu
# değeri göndermek ZORUNDA (health check hariç, o public). Boş bırakılırsa
# backend başlamaz (auth sessizce devre dışı kalmasın diye).
# Güçlü rastgele bir değer üret, ör:  python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=degistir-bu-degeri-guclu-rastgele-bir-anahtarla

# /data, docker-compose'daki named volume'e (agent_db) bağlıdır; DB kalıcı olur.
# 4 slash = mutlak yol (/data/app.db).
DATABASE_URL=sqlite:////data/app.db

# RAG (Faz 5) — ChromaDB vektör indeksinin kalıcı dizini. Docker'da /data
# (named volume) altında; compose bunu zaten ayarlar. Embedding modeli cache'i
# ayrıca HF_HOME=/data/hf'e iner (compose'da tanımlı).
CHROMA_DIR=/data/chroma

# MCP (Faz 8) — remote MCP server URL'lerinin private/loopback IP'lere
# çözülmesine izin ver.
# ⚠️ GÜVENLİK UYARISI: Bunu PRODUCTION'da MUTLAKA "false" bırakın.
# "true" yapmak SSRF guard'ını private IP aralıkları için DEVRE DIŞI bırakır;
# backend, kullanıcının girdiği bir URL üzerinden internal servislere,
# localhost'a veya cloud metadata endpoint'ine (169.254.169.254) bağlanabilir
# hâle gelir. Yalnızca LOCAL bir MCP server'ı test etmek için geçici açın.
ALLOW_PRIVATE_MCP_URLS=false
